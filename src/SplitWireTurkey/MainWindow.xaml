<Window x:Class="SplitWireTurkey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SplitWire-Turkey" 
        Height="640" Width="680"
        MinHeight="640" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Theme Toggle Switch Style -->
        <Style x:Key="ThemeToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#f5fdff"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Width="60" Height="32">
                            
                            <Grid>
                                <!-- Light Mode Icon -->
                                <Image x:Name="LightIcon" 
                                       Source="Resources/lightmode.png"
                                       Width="27" Height="27"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Opacity="1">
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="LightTransform" X="0"/>
                                    </Image.RenderTransform>
                                </Image>
                                
                                <!-- Dark Mode Icon -->
                                <Image x:Name="DarkIcon" 
                                       Source="Resources/darkmode.png"
                                       Width="20" Height="20"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Opacity="0">
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="DarkTransform" X="0"/>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Background Color Animation -->
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#020017" Duration="0:0:0.4">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            
                                            <!-- Light Icon Fade Out and Move -->
                                            <DoubleAnimation Storyboard.TargetName="LightIcon" 
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="LightTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="27" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            
                                            <!-- Dark Icon Fade In and Move -->
                                            <DoubleAnimation Storyboard.TargetName="DarkIcon" 
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2" BeginTime="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="DarkTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="25" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Background Color Animation -->
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#f5fdff" Duration="0:0:0.4">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            
                                            <!-- Dark Icon Fade Out and Move -->
                                            <DoubleAnimation Storyboard.TargetName="DarkIcon" 
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="DarkTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            
                                            <!-- Light Icon Fade In and Move -->
                                            <DoubleAnimation Storyboard.TargetName="LightIcon" 
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2" BeginTime="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="LightTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Gray" 
                                                        Direction="270" 
                                                        ShadowDepth="3" 
                                                        Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Animated Toggle Switch Style -->
        <Style x:Key="ModernToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Width="38" Height="20">
                            
                            <Ellipse x:Name="Switch" 
                                     Fill="White" 
                                     Width="16" Height="16"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="0,0,0,1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="SwitchTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#027ac4" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="19" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#E0E0E0" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Gray" 
                                                        Direction="270" 
                                                        ShadowDepth="2" 
                                                        Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Animated Toggle Switch Style - Dark Mode -->
        <Style x:Key="ModernToggleSwitchStyleDark" TargetType="ToggleButton">
            <Setter Property="Background" Value="#3f3f40"/>
            <Setter Property="BorderBrush" Value="#8e8e91"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Width="38" Height="20">
                            
                            <Ellipse x:Name="Switch" 
                                     Fill="#8e8e91" 
                                     Width="16" Height="16"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="0,0,0,1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="SwitchTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#f5f5f5" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="19" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#3f3f40" Duration="0:0:0.3">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Gray" 
                                                        Direction="270" 
                                                        ShadowDepth="2" 
                                                        Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Hizmet Kaldır Buton Stili -->
        <Style x:Key="ServiceRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="BorderBrush" Value="#FF0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="{StaticResource PoppinsRegular}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b83737"/>
                    <Setter Property="BorderBrush" Value="#FF0000"/>
                    <Setter Property="Foreground" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>
                <Style x:Key="AdvancedRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="BorderBrush" Value="#FF0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="{StaticResource PoppinsRegular}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b83737"/>
                    <Setter Property="BorderBrush" Value="#FF0000"/>
                    <Setter Property="Foreground" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="headerCard" 
                Grid.Row="0" 
                Margin="16,8,16,8" 
                Padding="8"
                Background="White"
                CornerRadius="4"
                Effect="{StaticResource MaterialDesignShadowDepth1}">
            <StackPanel>
                <Image x:Name="imgLogo"
                       Source="Resources/splitwire-logo-128.png" 
                       Width="96" 
                       Height="96" 
                       HorizontalAlignment="Center"
                       Margin="0,-8,0,0"/>
                <Image x:Name="imgText"
                       Source="Resources/splitwireturkeytext.png" 
                       Width="180" 
                       Height="Auto" 
                       HorizontalAlignment="Center"
                       Margin="0,2,0,2"/>
                
                <!-- Hakkında ve Dil Seçici Butonları -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="btnInfo" 
                            Content="ℹ" 
                            Style="{StaticResource InfoButtonStyle}"
                            Margin="0,0,5,0"
                            Click="BtnInfo_Click"/>
                    
                    <Button x:Name="btnLanguageSelector" 
                            Style="{StaticResource InfoButtonStyle}"
                            Margin="5,0,0,0"
                            Click="BtnLanguageSelector_Click">
                        <Image x:Name="imgLanguageIcon" 
                               Source="pack://application:,,,/Resources/language.png" 
                               Width="16" Height="16" 
                               Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                

            </StackPanel>
        </Border>
        
        <!-- Theme Toggle Switch - Absolute Positioned Overlay -->
        <ToggleButton x:Name="btnThemeToggle" 
                     Grid.Row="0"
                     Style="{StaticResource ThemeToggleSwitchStyle}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,16,24,0"
                     Panel.ZIndex="999"
                     Click="BtnThemeToggle_Click"/>

        <!-- Language Flag Menu - Absolute Positioned Overlay -->
        <StackPanel x:Name="languageMenu" 
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="370,148,0,0"
                    Panel.ZIndex="998"
                    Visibility="Collapsed"
                    Orientation="Horizontal">
            
            <!-- Turkish Flag -->
            <Button x:Name="btnLanguageTR" 
                    Style="{StaticResource InfoButtonStyle}"
                    Margin="2,0"
                    Click="BtnLanguageTR_Click"
                    Tag="TR"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.ShowDuration="5000">
                <Image Source="pack://application:,,,/Resources/Flags/tr_flag.png" 
                       Width="24" Height="24" 
                       Stretch="Uniform"/>
                <Button.ToolTip>
                    <ToolTip Content="Türkçe" 
                             FontFamily="Poppins Regular"
                             FontSize="12"/>
                </Button.ToolTip>
            </Button>
            
            <!-- English Flag -->
            <Button x:Name="btnLanguageEN" 
                    Style="{StaticResource InfoButtonStyle}"
                    Margin="2,0"
                    Click="BtnLanguageEN_Click"
                    Tag="EN"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.ShowDuration="5000">
                <Image Source="pack://application:,,,/Resources/Flags/gb_flag.png" 
                       Width="24" Height="24" 
                       Stretch="Uniform"/>
                <Button.ToolTip>
                    <ToolTip Content="English" 
                             FontFamily="Poppins Regular"
                             FontSize="12"/>
                </Button.ToolTip>
            </Button>
            
            <!-- Russian Flag -->
            <Button x:Name="btnLanguageRU" 
                    Style="{StaticResource InfoButtonStyle}"
                    Margin="2,0"
                    Click="BtnLanguageRU_Click"
                    Tag="RU"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.ShowDuration="5000">
                <Image Source="pack://application:,,,/Resources/Flags/ru_flag.png" 
                       Width="24" Height="24" 
                       Stretch="Uniform"/>
                <Button.ToolTip>
                    <ToolTip Content="Русский" 
                             FontFamily="Poppins Regular"
                             FontSize="12"/>
                </Button.ToolTip>
            </Button>
            
            <!-- Spanish Flag -->
            <Button x:Name="btnLanguageES" 
                    Style="{StaticResource InfoButtonStyle}"
                    Margin="2,0"
                    Click="BtnLanguageES_Click"
                    Tag="ES"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.ShowDuration="5000">
                <Image Source="pack://application:,,,/Resources/Flags/es_flag.png" 
                       Width="24" Height="24" 
                       Stretch="Uniform"/>
                <Button.ToolTip>
                    <ToolTip Content="Español" 
                             FontFamily="Poppins Regular"
                             FontSize="12"/>
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <TabControl x:Name="TabControl" Style="{StaticResource MaterialDesignTabControl}" SelectionChanged="TabControl_SelectionChanged" HorizontalAlignment="Stretch">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="2,3"/>
                    <Setter Property="Margin" Value="0,0"/>
                    <Setter Property="MinWidth" Value="60"/>
                    <Setter Property="MaxWidth" Value="150"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
                <Style TargetType="TabPanel">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
            </TabControl.Resources>
            
            <!-- Main Tab -->
            <TabItem Header="Ana Sayfa" FontFamily="{StaticResource PoppinsBold}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <Button x:Name="btnStart" 
                            Content="Standart Kurulum" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="300"
                            Height="50"
                            FontSize="16"
                            FontFamily="{StaticResource PoppinsBold}"
                            Background="Transparent"
                            Margin="0,0,0,10"
                            Click="BtnStart_Click"
                            ToolTipService.InitialShowDelay="1000"
                            ToolTipService.ShowDuration="5000">
                            <Button.ToolTip>
                                <ToolTip x:Name="tooltipStandardInstall" 
                                         FontFamily="Poppins Regular"
                                         FontSize="12"
                                         Placement="Mouse"/>
                            </Button.ToolTip>
                        </Button>
                        
                        <Button x:Name="btnAlternativeSetup" 
                                Content="Alternatif Kurulum" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="300"
                                Height="50"
                                FontSize="16"
                                FontFamily="{StaticResource PoppinsBold}"
                                Background="Transparent"
                                Margin="0,0,0,10"
                                Click="BtnAlternativeSetup_Click"
                                ToolTipService.InitialShowDelay="1000"
                                ToolTipService.ShowDuration="5000">
                            <Button.ToolTip>
                                <ToolTip x:Name="tooltipAlternativeInstall" 
                                         FontFamily="Poppins Regular"
                                         FontSize="12"
                                         Placement="Mouse"/>
                            </Button.ToolTip>
                        </Button>
                        
                        <!-- Tarayıcılar için Tünelleme Toggle Switch -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,5,0,10"
                                   ToolTipService.InitialShowDelay="1000"
                                   ToolTipService.ShowDuration="5000">
                            <StackPanel.ToolTip>
                                <ToolTip x:Name="tooltipBrowserTunneling" 
                                         FontFamily="Poppins Regular"
                                         FontSize="12"
                                         Placement="Mouse"/>
                            </StackPanel.ToolTip>
                            <ToggleButton x:Name="chkBrowserTunneling" 
                                         Style="{StaticResource ModernToggleSwitchStyle}"
                                         IsChecked="False"/>
                            <TextBlock x:Name="txtBrowserTunnelingMain" Text="Tarayıcılar için de tünelleme yap" 
                                       FontFamily="{StaticResource Montserrat}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                        
                        <!-- WireSock Yineleyici Switch -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,5,0,10"
                                   ToolTipService.InitialShowDelay="1000"
                                   ToolTipService.ShowDuration="5000">
                            <StackPanel.ToolTip>
                                <ToolTip x:Name="tooltipWireSockRepeater" 
                                         FontFamily="Poppins Regular"
                                         FontSize="12"
                                         Placement="Mouse"/>
                            </StackPanel.ToolTip>
                            <ToggleButton x:Name="chkWireSockRepeater" 
                                         Style="{StaticResource ModernToggleSwitchStyle}"
                                         IsChecked="False"/>
                            <TextBlock x:Name="txtWireSockRepeater" Text="WireSock yineleyici kur" 
                                       FontFamily="{StaticResource Montserrat}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Gelişmiş Ayarlar Toggle Switch -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,5,0,10"
                                   ToolTipService.InitialShowDelay="1000"
                                   ToolTipService.ShowDuration="5000">
                            <StackPanel.ToolTip>
                                <ToolTip x:Name="tooltipFolderCustomization" 
                                         FontFamily="Poppins Regular"
                                         FontSize="12"
                                         Placement="Mouse"/>
                            </StackPanel.ToolTip>
                            <ToggleButton x:Name="chkAdvancedSettings" 
                                         Style="{StaticResource ModernToggleSwitchStyle}"
                                         Checked="ChkAdvancedSettings_Checked"
                                         Unchecked="ChkAdvancedSettings_Unchecked"/>
                            <TextBlock x:Name="txtFolderCustomization" Text="Klasör listesini özelleştir" 
                                       FontFamily="{StaticResource Montserrat}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Gelişmiş Ayarlar Elementleri (Varsayılan olarak gizli) -->
                        <StackPanel x:Name="advancedSettingsPanel" 
                                   Orientation="Vertical" 
                                   Visibility="Collapsed">
                    
                    <!-- Folder Management -->
                        <TextBlock x:Name="txtFolderManagement" Text="Klasör Yönetimi" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="btnAddFolder" 
                                    Content="Klasör Ekle" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    FontFamily="{StaticResource PoppinsRegular}"
                                    Click="BtnAddFolder_Click"
                                    ToolTipService.InitialShowDelay="1000"
                                    ToolTipService.ShowDuration="5000">
                                <Button.ToolTip>
                                    <ToolTip x:Name="tooltipAddFolder" 
                                             FontFamily="Poppins Regular"
                                             FontSize="12"
                                             Placement="Mouse"/>
                                </Button.ToolTip>
                            </Button>
                            
                            <Button x:Name="btnClearFolders" 
                                    Content="Listeyi Temizle" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    FontFamily="{StaticResource PoppinsRegular}"
                                    Click="BtnClearFolders_Click"
                                    Margin="10,0,0,0"
                                    ToolTipService.InitialShowDelay="1000"
                                    ToolTipService.ShowDuration="5000">
                                <Button.ToolTip>
