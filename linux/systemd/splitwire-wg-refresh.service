[Unit]
Description=SplitWire-Turkey WireGuard Refresh
Documentation=https://github.com/cagritaskn/SplitWire-Turkey
After=splitwire-wg.service
Requires=splitwire-wg.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'wg-quick down splitwire && sleep 2 && wg-quick up splitwire'

# Don't restart automatically - timer handles scheduling
Restart=no

[Install]
WantedBy=multi-user.target
