[Unit]
Description=SplitWire-Turkey ByeDPI Proxy
Documentation=https://github.com/cagritaskn/SplitWire-Turkey
Documentation=https://github.com/hufrea/byedpi
After=network-online.target nss-lookup.target
Wants=network-online.target
Before=splitwire-cgproxy.service

[Service]
Type=simple

# Configuration
Environment=BYEDPI_BIN=/opt/splitwire/ciadpi
Environment=BYEDPI_PORT=1080
Environment=BYEDPI_OPT=--disorder 1 --split 1 --oob 1 --fake -1

# Start ciadpi (ByeDPI Linux binary)
ExecStart=/bin/bash -c '\
    ${BYEDPI_BIN} \
        --ip 127.0.0.1 \
        --port ${BYEDPI_PORT} \
        ${BYEDPI_OPT}'

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

# Only needs network access
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=

# Restrict system calls
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Required paths
ReadOnlyPaths=/opt/splitwire

# Restart on failure
Restart=on-failure
RestartSec=5

# Resource limits
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
